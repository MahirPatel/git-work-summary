# Optional. Bakes a fallback Groq API key into the packaged extension so AI
# features work without the user supplying their own. Copy to `.env` (gitignored,
# never committed) and fill in a real key before running `npm run package`.
# Leave unset for normal development — falls back to the existing "prompt the
# user for their own key" behavior.
DEFAULT_GROQ_API_KEY=
